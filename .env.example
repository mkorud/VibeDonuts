# Salin file ini menjadi .env lalu isi nilainya dari
# Supabase Dashboard -> Project Settings -> API.

# URL proyek TANPA akhiran /rest/v1/ (SDK yang menambahkannya otomatis)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Kunci anon (public) — aman dipakai di browser, asal RLS aktif.
# JANGAN PERNAH menaruh SERVICE_ROLE KEY di frontend.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Email yang dianggap admin (pisahkan dengan koma).
# Gunakan email sungguhan — domain contoh ditolak oleh validasi Supabase Auth.
VITE_ADMIN_EMAILS=admin@gmail.com
